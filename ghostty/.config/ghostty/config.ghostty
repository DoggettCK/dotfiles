# Font Configuration
font-family = JetBrainsMonoNL Nerd Font Mono
font-size = 14

# Window Configuration
# window-padding-x = 12
# window-padding-y = 12
background-opacity = 0.90
background-blur = 8
window-decoration = none

# Colors
theme = Catppuccin Mocha

# Cursor Configuration
cursor-style = block
cursor-style-blink = true
# No equivalent for kitty's cursor_trail / cursor_beam_thickness

# Scrollback (ghostty measures in bytes, not lines)
scrollback-limit = 10000000

# Terminal features
copy-on-select = true
clipboard-trim-trailing-spaces = true

# Shell integration
shell-integration = detect

# Key bindings for common actions
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+enter=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Alt+N to switch tabs
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9

# Cmd+N to switch tabs
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9

# Not ported from kitty: powerline tab bar, grid layout, and the F1 broadcast
# mapping (ghostty has no equivalents).

# Include overrides.ghostty / theme.ghostty if they exist (the "?" makes them
# optional). Put machine-specific settings in ~/.config/ghostty/overrides.ghostty
# and symlink the preferred theme to ~/.config/ghostty/theme.ghostty
config-file = ?overrides.ghostty
config-file = ?theme.ghostty
